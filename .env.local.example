# TiDB Cloud Database Connection
# Get this from TiDB Cloud Console > Cluster > Connect > General
# Format: mysql://username:password@host:4000/database_name?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://your_username:your_password@gateway01.region.prod.clustername.tidbcloud.com:4000/your_database?ssl={"rejectUnauthorized":true}
